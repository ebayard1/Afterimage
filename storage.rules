rules_version = '2';

// NOTE: Storage rules can't read Firestore, so membership is enforced at the
// Firestore layer (shot docs are members-only). Here we keep it to signed-in
// access with sane content-type/size limits. Photo URLs are unguessable
// (album id + random shot id), so read-for-signed-in is acceptable.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isImage() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 12 * 1024 * 1024; // 12 MB
    }
    function isVideo() {
      return request.resource.contentType.matches('video/.*')
             && request.resource.size < 200 * 1024 * 1024; // 200 MB
    }

    // Roll shots — images (photos + video posters) and videos.
    match /albums/{albumId}/shots/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && (isImage() || isVideo());
    }

    // User avatars — you may only write your own.
    match /users/{uid}/avatar.jpg {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
