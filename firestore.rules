rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ---- Users ----
    // Profiles are world-readable (so avatars/names/search work for any signed-in
    // user). You can only write your OWN profile. `friendIds` and `fcmTokens` are
    // maintained by the client (token) and Cloud Functions (friend accept).
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      // Activity feed + notifications are written ONLY by Cloud Functions (admin
      // SDK bypasses rules). Clients may read/update their own (e.g. mark read),
      // but never create.
      match /feed/{eventId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /notifications/{notifId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ---- Username registry (uniqueness + search support) ----
    // Claim a handle only if it's free and maps to you. No deletes/updates from
    // clients (handle changes would need a Function to keep both docs in sync).
    match /usernames/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Invite codes ----
    // Readable so a joiner can resolve a code → albumId. Created by the roll
    // creator at album creation.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---- Friend requests ----
    match /friendRequests/{reqId} {
      allow read: if signedIn() &&
                  (request.auth.uid == resource.data.fromUid ||
                   request.auth.uid == resource.data.toUid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      // The recipient may accept/decline (only the status field changes).
      allow update: if signedIn() && request.auth.uid == resource.data.toUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() &&
                    (request.auth.uid == resource.data.fromUid ||
                     request.auth.uid == resource.data.toUid);
    }

    // ---- Albums ----
    match /albums/{albumId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isMember() {
        return isSignedIn() &&
               request.auth.uid in resource.data.memberIds;
      }
      function isCreator() {
        return isSignedIn() &&
               request.auth.uid == resource.data.creatorId;
      }
      function joiningSelfOnly() {
        // For updates that only add the requesting user to memberIds and change nothing else of substance.
        let added = request.resource.data.memberIds.removeAll(resource.data.memberIds);
        return added.size() == 1 && added[0] == request.auth.uid;
      }
      function leavingSelfOnly() {
        let removed = resource.data.memberIds.removeAll(request.resource.data.memberIds);
        return removed.size() == 1 && removed[0] == request.auth.uid;
      }

      // Create: only your own user is the creator and sole initial member.
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      // Read: only members can read.
      allow read: if isMember();

      // Update: creator can do anything; members can join/leave themselves.
      allow update: if isCreator()
                    || (isSignedIn() && (joiningSelfOnly() || leavingSelfOnly()))
                    // any signed-in person can join by adding themselves (so QR scan works
                    // even before they're a member)
                    || (isSignedIn() && joiningSelfOnly() && !(request.auth.uid in resource.data.memberIds));

      // Delete: the creator, or the last remaining member as they leave (an
      // empty roll cleans itself up — see AlbumService.leave).
      allow delete: if isCreator()
                    || (isMember() && resource.data.memberIds.size() == 1);

      // ---- Shots subcollection ----
      match /shots/{shotId} {
        function parentMember() {
          return isSignedIn() &&
                 request.auth.uid in
                 get(/databases/$(database)/documents/albums/$(albumId)).data.memberIds;
        }
        function parentRevealed() {
          return get(/databases/$(database)/documents/albums/$(albumId)).data.revealAt
                 <= request.time;
        }

        // Members may read their OWN shots anytime (so the camera counter works),
        // but everyone else's shots only after the reveal time.
        allow read: if parentMember() &&
                    (parentRevealed() || resource.data.userId == request.auth.uid);

        // Create a shot only as yourself and only while album is still developing.
        allow create: if parentMember()
                      && request.resource.data.userId == request.auth.uid
                      && !parentRevealed();

        // Update (reactions) by any member after reveal — but only changes the reactions field.
        allow update: if parentMember() && parentRevealed()
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['reactions']);

        // Delete: the album creator, or the last remaining member tearing the
        // roll down as they leave (so the empty-roll cleanup can remove shots).
        allow delete: if isSignedIn() &&
                      (request.auth.uid ==
                        get(/databases/$(database)/documents/albums/$(albumId)).data.creatorId
                       || (request.auth.uid in
                            get(/databases/$(database)/documents/albums/$(albumId)).data.memberIds
                           && get(/databases/$(database)/documents/albums/$(albumId)).data.memberIds.size() == 1));
      }

      // ---- Comments subcollection ----
      match /comments/{commentId} {
        function member() {
          return isSignedIn() &&
                 request.auth.uid in
                 get(/databases/$(database)/documents/albums/$(albumId)).data.memberIds;
        }
        // Members read the thread and post as themselves.
        allow read: if member();
        allow create: if member() && request.resource.data.userId == request.auth.uid;
        // Likes: any member may toggle, but only the likedBy field changes.
        allow update: if member()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);
        // Authors may delete their own comment; creator may delete any.
        allow delete: if member() &&
                      (request.auth.uid == resource.data.userId ||
                       request.auth.uid ==
                       get(/databases/$(database)/documents/albums/$(albumId)).data.creatorId);
      }
    }
  }
}
